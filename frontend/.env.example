# Copy to .env.local. Defaults work with the local Firebase emulators.

# Firebase web app config (Firebase console > Project settings > Your apps)
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=demo-genesis

# true: sign in against the local Auth emulator (127.0.0.1:9099). Set false for a real project.
VITE_USE_AUTH_EMULATOR=true

# Backend base URL. In dev, /api is proxied to http://localhost:3000 by vite.config.js.
VITE_API_BASE=/api/v1
