# ─── Server ───────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── CORS ─────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173

# ─── Firebase / Firestore ──────────────────────────────────────────
# Option A – Firestore Emulator (local dev, no credentials needed)
# Uncomment and set your emulator host:
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_PROJECT_ID=demo-genesis

# Option B – Real Firebase project
# Set the path to your service-account key JSON, OR export the env
# variable in CI. Comment out the emulator vars above when using this.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# FIREBASE_PROJECT_ID=your-real-project-id

# ─── Dev / Demo auth bypass ───────────────────────────────────────
# When true, the "Authorization: Bearer" header is NOT required.
# Instead pass "x-dev-uid: <any_uid>" to identify as that user.
# NEVER enable this in production.
DEV_BYPASS_AUTH=true
